---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** For the 404 page: Workers also serves it with status 200 at /404, so keep it out of search engines. */
  noindex?: boolean;
}

const siteName = 'Heeler Docs';
const { title, description, noindex = false } = Astro.props;
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
// build.format 'file' makes the pathname `/tailscale.html`; Workers serves it at `/tailscale`.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/logo.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script>
      // The theme script sets `dark`/`light` and color-scheme on <html>, but a
      // client-side navigation swaps in the next page's bare <html> attributes.
      // Carry them over so the theme does not flash back to the default.
      document.addEventListener('astro:before-swap', (event) => {
        const current = document.documentElement;
        const next = event.newDocument.documentElement;
        next.className = current.className;
        const style = current.getAttribute('style');
        if (style === null) next.removeAttribute('style');
        else next.setAttribute('style', style);
      });
    </script>
  </head>
  <!-- Persisting the body keeps the React shell (sidebar, nav, scroll
       positions) mounted across navigations; Astro passes the new page's props
       and content to the persisted island. A full reload would re-render the
       sidebar and re-rasterize its text on every click. -->
  <body
    class="flex min-h-screen flex-col"
    transition:persist
    transition:animate="none"
    transition:name="page-layout"
  >
    <slot />
  </body>
</html>
