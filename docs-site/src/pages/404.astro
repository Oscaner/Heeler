---
import { Docs } from '@/components/docs';
import Layout from '@/components/layout.astro';
import { source } from '@/lib/source.ts';
---

<Layout title="Page not found" description="This page does not exist on Heeler Docs." noindex>
  <Docs tree={source.getPageTree()} pathname={Astro.url.pathname} params={{}} client:load>
    <main class="mx-auto flex w-full max-w-xl flex-1 flex-col justify-center gap-4 px-6 py-16">
      <h1 class="text-3xl font-semibold">Page not found</h1>
      <p class="text-fd-muted-foreground">
        There is no guide at this address. Pick one from the sidebar, search, or go back to
        the <a class="text-fd-foreground underline underline-offset-4" href="/">documentation home</a>.
      </p>
    </main>
  </Docs>
</Layout>
