---
import { render } from 'astro:content';
import type { TOCItemType } from 'fumadocs-core/toc';
import defaultMdxComponents from 'fumadocs-ui/mdx';
import { Docs } from '@/components/docs';
import Layout from '@/components/layout.astro';
import { source } from '@/lib/source.ts';

export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { page },
  }));
}

type Props = ReturnType<typeof getStaticPaths>[number]['props'];

const { page } = Astro.props;
const { entry, title, description, sourceUrl } = page.data;
const { Content, headings } = await render(entry);

// The rendered headings already carry GitHub-style ids (remarkHeading); the H1
// was removed from guides, so the TOC lists only the sections.
const toc: TOCItemType[] = headings
  .filter((heading) => heading.depth > 1)
  .map((heading) => ({ depth: heading.depth, title: heading.text, url: `#${heading.slug}` }));
---

<Layout title={title} description={description}>
  <Docs
    tree={source.getPageTree()}
    pathname={page.url}
    params={Astro.params}
    page={{
      title,
      description: entry.collection === 'pages' ? description : undefined,
      toc,
      sourceUrl,
    }}
    client:load
  >
    <Content components={defaultMdxComponents} />
  </Docs>
</Layout>

<script>
  // Copy buttons emitted by rehypeFumadocsElements. Delegated, so it keeps
  // working whatever React does with the island's static content.
  document.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-copy-code]') : null;
    const code = button?.closest('figure')?.querySelector('pre')?.textContent;
    const label = button?.querySelector('.sr-only');
    if (!(button instanceof HTMLElement) || code == null) return;
    try {
      await navigator.clipboard.writeText(code.replace(/\n$/, ''));
    } catch {
      return;
    }
    // data-checked swaps the clipboard icon for a check mark.
    button.dataset.checked = '';
    if (label) label.textContent = 'Copied code';
    setTimeout(() => {
      delete button.dataset.checked;
      if (label) label.textContent = 'Copy code';
    }, 1500);
  });
</script>
